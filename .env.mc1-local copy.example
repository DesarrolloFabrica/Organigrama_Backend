# Configuración LOCAL aislada para MC1.1B — no es Cloud SQL.
# Copiar a .env.mc1-local (gitignored).
DB_HOST=127.0.0.1
# Docker Compose (preferido): 5433. PostgreSQL instalado localmente: 5432.
DB_PORT=5432
DB_NAME=mc1_local
DB_USERNAME=mc1_local
DB_PASSWORD=mc1_local_password
DB_SSL=false
DB_SYNCHRONIZE=false
DB_LOGGING=false
NODE_ENV=development
