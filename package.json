{
  "name": "Organigrama_Backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed": "npm run build && node dist/database/run-seed.js",
    "org:grant-admin": "npm run build && node dist/database/scripts/grant-admin.js",
    "diag:profile-photo": "npm run build && node dist/database/scripts/diag-profile-photo.js",
    "diag:drive-cv": "npm run build && node dist/database/scripts/diag-drive-cv.js",
    "diag:drive-cv-compare": "npm run build && node dist/database/scripts/diag-drive-cv-compare.js",
    "diag:download-cv": "npm run build && node dist/database/scripts/diag-download-cv.js",
    "generate:drive-cv-token": "npm run build && node dist/database/scripts/generate-drive-cv-token.js",
    "sync:drive-cv": "npm run build && node dist/database/scripts/sync-drive-cv.js",
    "extract:cv-skills": "npm run build && node dist/database/scripts/extract-cv-skills.js",
    "extract:cv-skills:batch": "npm run build && node dist/database/scripts/extract-cv-skills-batch.js",
    "extract:cv-skills:version": "npm run build && node dist/database/scripts/extract-cv-skills-version.js",
    "enrich:cv-skills": "npm run build && node dist/database/scripts/enrich-cv-skills.js",
    "enrich:cv-skills:compare": "npm run build && node dist/database/scripts/compare-enrichment-stability.js",
    "enrich:cv-skills:activate": "npm run build && node dist/database/scripts/enrich-cv-skills-activate.js",
    "enrich:cv-skills:deactivate": "npm run build && node dist/database/scripts/enrich-cv-skills-deactivate.js",
    "enrich:cv-skills:status": "npm run build && node dist/database/scripts/enrich-cv-skills-status.js",
    "enrich:cv-skills:inspect": "npm run build && node dist/database/scripts/enrich-cv-skills-inspect.js",
    "evaluate:cv-evidence": "npm run build && node dist/database/scripts/evaluate-cv-evidence.js",
    "evaluate:cv-evidence:status": "npm run build && node dist/database/scripts/evaluate-cv-evidence-status.js",
    "evaluate:cv-evidence:inspect": "npm run build && node dist/database/scripts/evaluate-cv-evidence-inspect.js",
    "evaluate:cv-evidence:activate": "npm run build && node dist/database/scripts/evaluate-cv-evidence-activate.js",
    "evaluate:cv-evidence:compare": "npm run build && node dist/database/scripts/evaluate-cv-evidence-compare.js",
    "evaluate:cv-attributes": "npm run build && node dist/database/scripts/evaluate-cv-attributes.js",
    "evaluate:cv-attributes:status": "npm run build && node dist/database/scripts/evaluate-cv-attributes-status.js",
    "evaluate:cv-attributes:inspect": "npm run build && node dist/database/scripts/evaluate-cv-attributes-inspect.js",
    "evaluate:cv-attributes:activate": "npm run build && node dist/database/scripts/evaluate-cv-attributes-activate.js",
    "evaluate:cv-attributes:catalog": "npm run build && node dist/database/scripts/evaluate-cv-attributes-catalog.js",
    "diag:google-photo": "npm run build && node dist/google-workspace/run-photo-diagnostic.js",
    "diag:org-photo": "npm run build && node dist/org-chart/run-org-node-photo-diagnostic.js"
  },
  "dependencies": {
    "@google/genai": "^2.13.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/typeorm": "^11.0.1",
    "google-auth-library": "^10.6.2",
    "googleapis": "^172.0.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
