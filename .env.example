# Variables de entorno (copiar a `.env` en esta carpeta)

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=core
# Opcional: search_path por defecto. Las entidades usan schema `core` y `organigrama`.
# DB_SCHEMA=

# IP publica de Cloud SQL (solo si la red lo permite). En Cloud Run suele hacer TIMEOUT:
# DB_HOST=136.113.128.135
# DB_SSL=true
#
# Recomendado en Cloud Run: vincular la instancia en el servicio y usar socket:
#   gcloud run services update SERVICIO --add-cloudsql-instances=PROYECTO:REGION:INSTANCIA
# DB_HOST=/cloudsql/it-fab-contenido-edu-5:us-central1:TU_INSTANCIA
# DB_SSL=false

# En desarrollo puede ser `true`. En producción (Cloud Run) debe ser `false`.
DB_SYNCHRONIZE=false
DB_LOGGING=false

NODE_ENV=production
CORS_ORIGIN=https://tu-frontend.run.app
# Cloud Run inyecta PORT=8080; en local no hace falta definirlo.
# DEV_LOGIN_ENABLED=false (obligatorio en producción; ver .env.production)

# --- Endpoints legacy del organigrama ---
# Producción (Cloud Run): OBLIGATORIO false — bloquea GET /api/org-chart y GET /api/org-chart/team/:id (410 Gone).
# Desarrollo local: puede ser true si necesitas probar el árbol completo legacy.
# Si la variable está ausente o vacía, el backend trata legacy como habilitado (true).
ORG_CHART_LEGACY_ENABLED=false

# --- Fotos organigrama ---
# ORG_CHART_PHOTOS_ENABLED=false
# API_PUBLIC_BASE_URL=http://localhost:3000
# ORG_CHART_PHOTO_CACHE_TTL_MS=86400000
# ORG_CHART_PHOTO_NEGATIVE_CACHE_TTL_MS=3600000
# ORG_CHART_PHOTO_FETCH_CONCURRENCY=5
# ORG_CHART_PHOTO_TEST_URL=https://i.pravatar.cc/256?u=organigrama-root

# --- Google Workspace fotos (requiere DWD aprobado; Fase B) ---
# GOOGLE_WORKSPACE_PHOTOS_ENABLED=false

# --- Login Google (colaboradores @cun.edu.co registrados en Core) ---
# GOOGLE_CLIENT_ID=550902908078-fvabjtle954fqr6alhofdv7fvvr4bcbv.apps.googleusercontent.com
# AUTH_JWT_SECRET=cambiar-en-produccion-min-32-caracteres
# AUTH_JWT_EXPIRES_IN=7d
# DEV_LOGIN_ENABLED=false

# --- Ticket temporal de stream de video de presentación (Fase 3B) ---
# Secreto dedicado (HS256). Mínimo 32 caracteres.
# NO reutilizar AUTH_JWT_SECRET ni credenciales / tokens de Google Drive.
# En Cloud Run: inyectar desde Secret Manager. Nunca commitear el valor real.
# PERSON_VIDEO_STREAM_TICKET_SECRET=
# TTL en segundos (default 120). Rango aceptado: 30–600. Inválido → 120 + warning.
# PERSON_VIDEO_STREAM_TICKET_TTL_SECONDS=120
# Timeout de apertura upstream Drive (ms). Default 20000. Rango 5000–60000.
# PERSON_VIDEO_STREAM_UPSTREAM_TIMEOUT_MS=20000
# Credencial OAuth readonly compartida con CV (GOOGLE_DRIVE_CV_TOKEN_PATH).
# Local: ruta a JSON (ej. ./secrets/google-drive-token.json). No commitear el archivo.
# Cloud Run: Secret Manager organigrama-google-drive-oauth-token montado como
#   /secrets/google-drive-token.json y GOOGLE_DRIVE_CV_TOKEN_PATH apuntando a esa ruta.
# La carpeta/lógica de videos permanece separada (GOOGLE_DRIVE_VIDEO_FOLDER_ID).
# El streaming runtime no requiere Folder ID: usa drive_file_id en person_video.

# --- Login central (logs.login_apps en DB Orbit/core; fire-and-forget) ---
# Si no están configuradas, el login sigue sin registrar.
# LOGIN_LOGS_DB_HOST=136.113.128.135
# LOGIN_LOGS_DB_PORT=5432
# LOGIN_LOGS_DB_NAME=core
# LOGIN_LOGS_DB_USER=user-core
# LOGIN_LOGS_DB_PASSWORD=
# LOGIN_LOGS_DB_SSL=true

# --- Usuarios técnicos (excepción a la regla del _ en edu_email) ---
# Correos que pueden autenticarse aunque su edu_email no contenga `_`.
# Separados por coma. Normalizados a trim + lowercase.
# Solo permite el login; los permisos de acceso se controlan por ORG_ADMIN_EMAILS o core.person_permission.
# ORG_TECHNICAL_EMAILS=desarrollofabrica@cun.edu.co,iron_fuentes@cun.edu.co,raul_valencia@cun.edu.co,haider_bello@cun.edu.co

# --- Versionamiento del organigrama ---
# Correos que pueden usar selector, snapshots, compare y versionId/versionCode en la API.
# Separados por coma. Normalizados a trim + lowercase.
# ORG_CHART_VERSION_ADMIN_EMAILS=desarrollofabrica@cun.edu.co,iron_fuentes@cun.edu.co,raul_valencia@cun.edu.co,haider_bello@cun.edu.co,sara_murillofo@cun.edu.co

# --- Permisos técnicos de administración ---
# Admins técnicos de arranque (fallback, no requiere core.person_permission).
# Separados por coma. Para persistir permisos usar: npm run org:grant-admin -- correo@cun.edu.co
# Si los permisos cambian, el usuario debe cerrar sesion y volver a iniciar para actualizar su JWT.
# IMPORTANTE: nunca insertar a estos usuarios en organigrama.org_visual_relation.
# Ejecutar antes de usar: migrations/004_core_person_permission.sql
# ORG_ADMIN_EMAILS=jose_camachoc@cun.edu.co

# --- Onboarding perfil (Fase 1) ---
# Ejecutar en Cloud SQL:
#   migrations/001_person_profile_state.sql
#   migrations/003_core_person_emergency_contact.sql
# PROFILE_DEV_RESET_ENABLED=true
# PROFILE_DEV_RESET_ALLOWED_EMAILS=jose_camachoc@cun.edu.co

# --- Fase 0: diagnóstico Google Workspace (NO activar en producción) ---
# GOOGLE_WORKSPACE_PHOTO_DIAG_ENABLED=true
# GOOGLE_WORKSPACE_PHOTO_DIAG_ALLOW_IN_PRODUCTION=false
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./secrets/google-service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"..."}
# GOOGLE_WORKSPACE_ADMIN_EMAIL=admin@institucion.edu

# --- Extracción de skills desde CV (Gemini) ---
# Obligatoria para CvSkillsExtractionService.extractSkills.
# GEMINI_API_KEY=
# Opcional; por defecto gemini-3.6-flash
# GEMINI_MODEL=gemini-3.6-flash

# --- MC1 shadow resolver (observabilidad interna; no salta Gemini) ---
# Default false. No activar en producción.
# MC1_SHADOW_RESOLVER_ENABLED=false
